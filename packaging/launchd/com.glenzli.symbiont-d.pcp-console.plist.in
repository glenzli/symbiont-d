<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.glenzli.symbiont-d.pcp-console</string>

  <key>ProgramArguments</key>
  <array>
    <string>@PCP_CONSOLE_BINARY@</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@PCP_PROJECT_ROOT@</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>@PATH@</string>
    <key>PCP_CLIENT_ID</key>
    <string>operator:local</string>
    <key>PCP_CONSOLE_BIND</key>
    <string>127.0.0.1:4318</string>
    <key>PCP_RUNTIME_SOCKET</key>
    <string>@PCP_OPERATOR_SOCKET@</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>@LOG_DIR@/pcp-console-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/pcp-console-stderr.log</string>
</dict>
</plist>
