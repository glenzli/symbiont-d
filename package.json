{
  "name": "symbiont-d-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:rich-text": "esbuild web/rich-text-source.js --bundle --format=esm --minify --loader:.woff2=dataurl --loader:.woff=dataurl --loader:.ttf=dataurl --outfile=web/rich-text.js",
    "build:icons": "esbuild web/icons-source.js --bundle --format=esm --minify --outfile=web/icons.js",
    "build:web": "npm run build:rich-text && npm run build:icons",
    "test:web": "node --test web/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "katex": "^0.16.22",
    "lucide": "^1.28.0",
    "markdown-it": "^15.0.1",
    "@mdit/plugin-tex": "^1.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "jsdom": "^26.1.0"
  }
}
